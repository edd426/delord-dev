---
import Base from '../layouts/Base.astro';
import Fleur from '../components/Fleur.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  label: string;
  labelArcane?: string;
  heading: string;
  headingArcane?: string;
}

const { title, description, label, labelArcane = label, heading, headingArcane = heading } = Astro.props;
---
<Base title={title} description={description}>
  <div class="page">
    <div class="frame">
      <main class="main">
        <div class="brand"><a href="/">DeLord<span>.dev</span></a></div>
        <div class="section-label" style="width: auto;"><span class="only-default">{label}</span><span class="only-arcane">{labelArcane}</span></div>
        <h1 class="name" style="font-size: 40px; margin-top: 8px;"><span class="only-default">{heading}</span><span class="only-arcane">{headingArcane}</span></h1>
        <Fleur />
        <div class="stub">
          <slot />
          <div class="back"><a href="/">&larr; Back to the front page</a></div>
        </div>
        <Footer />
      </main>
    </div>
  </div>
</Base>
