---
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  forceArcane?: boolean;
  noindex?: boolean;
}

const {
  title = 'Evan DeLord — platform engineer',
  description = 'Evan DeLord is a platform engineer working on cloud infrastructure and careful measurement of AI coding agents.',
  forceArcane = false,
  noindex = false,
} = Astro.props;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Evan DeLord',
  jobTitle: 'Platform Engineer',
  url: 'https://delord.dev',
  sameAs: [
    'https://github.com/edd426',
    'https://www.linkedin.com/in/eddelord',
  ],
});
---
<!doctype html>
<html lang="en" data-theme={forceArcane ? 'arcane' : undefined} data-force-arcane={forceArcane ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link id="favicon" rel="icon" type="image/svg+xml" href={forceArcane ? '/favicon-arcane.svg' : '/favicon.svg'} />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="delord.dev" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={jsonLd} />
    <script is:inline>
      try {
        var stage = parseInt(localStorage.getItem('candle-stage'), 10);
        if (isNaN(stage)) {
          stage = localStorage.getItem('theme') === 'arcane' ? 3 : 0;
          localStorage.removeItem('theme');
          localStorage.setItem('candle-stage', String(stage));
        }
        stage = Math.max(0, Math.min(3, stage));
        if (stage > 0) document.documentElement.setAttribute('data-candle-stage', String(stage));
        if (stage === 3) {
          document.documentElement.setAttribute('data-theme', 'arcane');
          var fav = document.getElementById('favicon');
          if (fav) fav.href = '/favicon-arcane.svg';
        }
      } catch (e) {}
    </script>
    <style is:inline>
      .only-arcane { display: none; }
      [data-theme="arcane"] .only-arcane { display: revert; }
      [data-theme="arcane"] .only-default { display: none; }
    </style>
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var forced = root.hasAttribute('data-force-arcane');
        function getStage() {
          var s = parseInt(root.getAttribute('data-candle-stage') || '0', 10);
          return isNaN(s) ? 0 : s;
        }
        function loadV2() {
          import('/arcane-v2.js')
            .then(function () {
              if (!window.arcaneV2) return;
              // the stage may have changed while the chunk was loading
              if (forced || getStage() === 3) window.arcaneV2.enable();
              else window.arcaneV2.disable();
            })
            .catch(function () {});
        }
        function apply(stage) {
          if (stage > 0) root.setAttribute('data-candle-stage', String(stage));
          else root.removeAttribute('data-candle-stage');
          if (stage === 3) {
            root.setAttribute('data-theme', 'arcane');
            loadV2();
          } else if (!forced) {
            root.removeAttribute('data-theme');
            if (window.arcaneV2) window.arcaneV2.disable();
          }
          var fav = document.getElementById('favicon');
          if (fav) fav.href = (forced || stage === 3) ? '/favicon-arcane.svg' : '/favicon.svg';
          try { localStorage.setItem('candle-stage', String(stage)); } catch (e) {}
        }
        var btn = document.getElementById('candle');
        if (btn) btn.addEventListener('click', function () { apply((getStage() + 1) % 4); });
        if (forced || getStage() === 3) loadV2();
      })();
    </script>
  </body>
</html>
