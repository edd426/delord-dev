---
import Base from '../layouts/Base.astro';
import Fleur from '../components/Fleur.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <div class="page">
    <div class="frame">
      <main class="main">
        <div class="masthead">
          <div class="brand">DeLord<span>.dev</span></div>
          <a class="top-link" href="/about"><span class="only-default">About</span><span class="only-arcane">Concerning</span></a>
        </div>
        <h1 class="name">Evan DeLord</h1>
        <p class="tagline">
          <span class="only-default">Platform engineer. Cloud infrastructure. AI hobbyist.</span>
          <span class="only-arcane">Platform engineer. Cloud infrastructure. Dabbler in artificial minds.</span>
        </p>
        <Fleur />
        <div class="sections">
          <div class="section-row">
            <div class="section-label"><span class="only-default">Experiments</span><span class="only-arcane">Workings</span></div>
            <div class="section-body research">
              <a href="/work" class="section-title"><span class="only-default">Projects &amp; Experiments</span><span class="only-arcane">Constructions</span></a>
              <div class="section-desc">
                <span class="only-default">Playful, exploratory projects — AI agents left to their own devices, simulations, and the occasional app that graduated to a repo.</span>
                <span class="only-arcane">In cloud and code. Sources kept openly at GitHub, under edd426.</span>
              </div>
              <ul class="post-list">
                <li><a href="/work/cabin-and-tower"><span class="only-default">The Cabin &amp; the Tower</span><span class="only-arcane">Two keepers, by letter</span></a></li>
                <li><a href="/work/claude-autobiographies"><span class="only-default">The Claude Autobiographies</span><span class="only-arcane">Portraits, self-drawn</span></a></li>
              </ul>
            </div>
          </div>
        </div>
        <Footer />
      </main>
    </div>
  </div>
</Base>
